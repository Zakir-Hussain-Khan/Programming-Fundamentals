// Print all even numbers between 1 and N
#include<stdio.h>
int main (){
    int num;
    printf("Enter your number: ");
    scanf("%d",&num);
    if(num<=0){
        printf("Please enter a positve number!");
    }else{
           for(int i=2; i<=num;i++){
            if(i%2==0){
                printf("%d ",i);
            }
    }
    }

    return 0;
}
