// Find sum of first N natural numbers
#include<stdio.h>

int main (){
        int num, sum = 0;
        printf("Enter your number: ");
        scanf("%d",&num);
     if(num <= 0){
        printf("Please enter a positive number!\n");
    }else{
        for(int i=1; i<=num;i++){
         sum += i;
    }
        printf("Sum of first %d natural numbers is: %d\n", num, sum);
        }
    return 0;
}
